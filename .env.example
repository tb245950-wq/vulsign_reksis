# VulnSight - Local Development

APP_NAME=VulnSight
APP_ENV=development
APP_DEBUG=true

# Frontend
WEBSITE_PORT=3000
PORTAL_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8080

# Go API
API_PORT=8080
API_HOST=0.0.0.0

# PostgreSQL
POSTGRES_DB=vulnsight
POSTGRES_USER=vulnsight
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgres://vulnsight:change_me_local_only@postgres:5432/vulnsight?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ML Service
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://ml-service:8000

# Authentication
JWT_SECRET=replace_with_random_secret
JWT_EXPIRATION_MINUTES=60

# Security Assessment
SANDBOX_ENABLED=false
ASSESSMENT_ENABLED=false
