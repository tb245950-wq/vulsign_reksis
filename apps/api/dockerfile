
# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux \
    go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/vulnsight-api \
    ./cmd/server

FROM alpine:3.22 AS runner

RUN apk add --no-cache ca-certificates \
    && addgroup -S app \
    && adduser -S -G app app

WORKDIR /app

COPY --from=builder /out/vulnsight-api ./vulnsight-api

USER app

EXPOSE 8080

CMD ["./vulnsight-api"]
